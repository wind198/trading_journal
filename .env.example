NEXT_PUBLIC_SUPABASE_URL=https://*.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_*.key
# Server-only. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_*.key
# Chart axis + crosshair time labels (IANA). Default Asia/Ho_Chi_Minh (UTC+7).
NEXT_PUBLIC_CHART_TIME_ZONE=Asia/Ho_Chi_Minh
# Local dev only — skip login on localhost (pages + market APIs). Never set in production.
DISABLE_AUTH_ON_LOCALHOST=true
NEXT_PUBLIC_DISABLE_AUTH_ON_LOCALHOST=true
# Execution bridge (server-only unless noted).
EXECUTION_WS_URL=http://127.0.0.1:8091
EXECUTION_BFF_CLIENT_ID=journal-bff
EXECUTION_BFF_SECRET=change-me-bff-secret-32-bytes-minimum
EXECUTION_DEFAULT_DEVICE_ID=home-mt5
EXECUTION_INSTALL_ACK_TIMEOUT_MS=15000