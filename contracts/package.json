{
  "name": "@mt5/execution-contracts",
  "version": "2.0.0",
  "private": true,
  "description": "Generated TypeScript types for MT5 execution bridge wire contracts",
  "type": "module",
  "exports": {
    ".": "./generated/typescript/index.ts"
  },
  "scripts": {
    "validate": "node scripts/validate-asyncapi.mjs",
    "generate:ts": "python3 scripts/compile_schemas.py && node scripts/generate-typescript.mjs",
    "generate": "bash ./scripts/generate.sh",
    "bundle": "node scripts/bundle-asyncapi.mjs"
  },
  "devDependencies": {
    "@asyncapi/bundler": "0.6.4",
    "@asyncapi/parser": "3.6.6",
    "json-schema-to-typescript": "15.0.4"
  }
}
